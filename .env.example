NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
HOOMA_IMPORT_ALLOWED_HOSTS=
GOOGLE_CLOUD_TRANSLATION_API_KEY=
OPENAI_API_KEY=
HOOMA_ASSISTANT_MODEL=gpt-5-mini
# Optional dedicated HMAC secret. If omitted, the server derives the
# privacy-preserving rate-limit key with OPENAI_API_KEY.
HOOMA_ASSISTANT_RATE_LIMIT_SECRET=
# Public support form. Keep disabled until the contact migration is applied and
# a separate Resend sending-only API key is configured in Vercel Production.
HOOMA_CONTACT_ENABLED=false
RESEND_API_KEY=
HOOMA_CONTACT_FROM_EMAIL=Hooma Website <support@hooma.ge>
HOOMA_CONTACT_RATE_LIMIT_SECRET=
# BOG hosted checkout is fail-closed unless explicitly enabled and fully configured.
BOG_PAYMENTS_ENABLED=false
# Independent, fail-closed switch for irreversible customer refund requests.
# Existing-order refunds do not depend on BOG_PAYMENTS_ENABLED.
BOG_CUSTOMER_REFUNDS_ENABLED=false
# Hooma+ has an independent launch switch and also requires BOG_PAYMENTS_ENABLED.
HOOMA_PLUS_PAYMENTS_ENABLED=false
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# Start with card. Add google_pay/apple_pay only after BOG activates them.
BOG_PAYMENT_METHODS=card
# Optional public-key override for a bank-announced key rotation. This is not a secret.
BOG_CALLBACK_PUBLIC_KEY=
