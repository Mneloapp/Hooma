NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=
HOOMA_IMPORT_ALLOWED_HOSTS=
GOOGLE_CLOUD_TRANSLATION_API_KEY=
OPENAI_API_KEY=
HOOMA_ASSISTANT_MODEL=gpt-5-mini
# Optional dedicated HMAC secret. If omitted, the server derives the
# privacy-preserving rate-limit key with OPENAI_API_KEY.
HOOMA_ASSISTANT_RATE_LIMIT_SECRET=
# Public support form. Keep disabled until the contact migration is applied and
# a separate Resend sending-only API key is configured in Vercel Production.
HOOMA_CONTACT_ENABLED=false
RESEND_API_KEY=
HOOMA_CONTACT_FROM_EMAIL=Hooma Website <support@hooma.ge>
HOOMA_CONTACT_RATE_LIMIT_SECRET=
# BOG hosted checkout is fail-closed unless explicitly enabled and fully configured.
BOG_PAYMENTS_ENABLED=false
# Independent, fail-closed switch for irreversible customer refund requests.
# Existing-order refunds do not depend on BOG_PAYMENTS_ENABLED.
BOG_CUSTOMER_REFUNDS_ENABLED=false
# Hooma+ has an independent launch switch and also requires BOG_PAYMENTS_ENABLED.
HOOMA_PLUS_PAYMENTS_ENABLED=false
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# Start with card. Add google_pay/apple_pay only after BOG activates them.
BOG_PAYMENT_METHODS=card
# Optional public-key override for a bank-announced key rotation. This is not a secret.
BOG_CALLBACK_PUBLIC_KEY=

# Social publishing — server-only. Store real values in Vercel or .env.local.
HOOMA_SOCIAL_PUBLISHING_ENABLED=0
# Instagram OAuth and token maintenance stay on after account connection while
# publishing remains independently disabled. During rollout only, an absent
# OAuth flag inherits the legacy global switch; configure this flag explicitly.
HOOMA_INSTAGRAM_OAUTH_ENABLED=0
# Future Instagram publishing must require this provider switch and the global
# emergency switch. Keep it off until the adapter, staging, music, and approval
# gates are independently verified.
HOOMA_INSTAGRAM_PUBLISHING_ENABLED=0
# TikTok OAuth and token maintenance use a separate connection gate. Keep it
# off until TikTok approves the app and exact returned scope IDs are frozen;
# keep it on after connection so refresh can run while publishing stays off.
HOOMA_TIKTOK_OAUTH_ENABLED=0
HOOMA_SOCIAL_STATE_SECRET=
HOOMA_SOCIAL_MEDIA_BASE_URL=
SOCIAL_TOKEN_ENCRYPTION_KEYS_JSON=
SOCIAL_TOKEN_ENCRYPTION_ACTIVE_KID=hooma-social-primary
SOCIAL_TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=1
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
TIKTOK_BUSINESS_AUTH_URL=https://ads.tiktok.com/marketing_api/auth
TIKTOK_BUSINESS_REDIRECT_URI=https://hooma.ge/api/social/oauth/tiktok/callback/
# Copy only exact machine identifiers returned for the approved app. Do not
# translate developer-portal permission labels into guessed scope strings.
TIKTOK_BUSINESS_APPROVED_SCOPES=
TIKTOK_BUSINESS_EXPECTED_USERNAME=hooma.ge
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_REDIRECT_URI=https://hooma.ge/api/social/oauth/instagram/callback
INSTAGRAM_REQUIRED_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_EXPECTED_USERNAME=hooma.ge
