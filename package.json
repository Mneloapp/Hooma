{
  "name": "hooma-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrations": "supabase migration list --linked",
    "db:push:dry-run": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:seo": "node scripts/seo-regression.mjs",
    "test:sitemap": "node --experimental-strip-types --test tools/sitemap-catalog-rules.test.mjs",
    "test:auth": "node --test tools/auth-confirmation-rules.test.mjs tools/account-settings-rules.test.mjs",
    "test:assistant": "node --experimental-strip-types --test tools/storefront-assistant-rules.test.mjs",
    "test:audit-launch": "node --test tools/catalog-audit-launch-rules.test.mjs",
    "test:cart": "node --experimental-strip-types --test tools/cart-isolation-rules.test.mjs",
    "test:storefront": "node --experimental-strip-types --test tools/storefront-home-rules.test.mjs tools/account-navigation-rules.test.mjs tools/google-maps-location-rules.test.mjs tools/contact-support-rules.test.mjs",
    "test:payments": "node --experimental-strip-types --test tools/bog-payment-rules.test.mjs tools/order-cancellation-rules.test.mjs",
    "test:hooma-plus": "node --experimental-strip-types --test tools/hooma-plus-rules.test.mjs",
    "test:social-dashboard": "node --test tools/social-automation-dashboard-rules.test.mjs",
    "test:social:instagram": "tsc --noEmit --pretty false && node tests/support/run-typescript-tests.cjs lib/social/providers/instagram-login.test.ts lib/social/providers/instagram-reels-read.test.ts lib/social/providers/instagram-reels-publish.test.ts",
    "test:social:instagram:lifecycle": "node --test tools/instagram-container-lifecycle-rules.test.mjs",
    "test:social:tiktok": "tsc --noEmit --pretty false && node tests/support/run-typescript-tests.cjs lib/social/providers/tiktok-oauth.test.ts lib/social/providers/tiktok-business-organic.test.ts lib/social/token-refresh-orchestrator.test.ts lib/social/token-refresh-worker.test.ts && node --test tools/social-token-cron-rules.test.mjs tools/tiktok-cml-db-rules.test.mjs tools/tiktok-oauth-contract-rules.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.4.49",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
