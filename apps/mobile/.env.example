# Values prefixed EXPO_PUBLIC_ are bundled into the app. Never put secrets here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_OWNER=

# Build-time identifiers. Confirm these before first store submission.
HOOMA_IOS_BUNDLE_ID=ge.hooma.app
HOOMA_ANDROID_APPLICATION_ID=ge.hooma.app
